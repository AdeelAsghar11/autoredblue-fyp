# Copy to .env and adjust. Optional environment-variable overrides for
# config/settings.yaml: useful for docker-compose / CI contexts where env
# vars are easier to inject than editing YAML. config/settings.yaml (copied
# from config/settings.example.yaml) is the authoritative default source;
# see docs/ARCHITECTURE.md for what each value means.

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
CHROMA_PERSIST_DIR=./chroma_data
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
